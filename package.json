{
  "name": "redisfx",
  "version": "1.1.0",
  "description": "FXServer to Redis communication via node-redis",
  "bugs": "https://github.com/m3ftwz/redisfx/issues",
  "license": "LGPL-3.0",
  "author": "m3ftwz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/m3ftwz/redisfx.git"
  },
  "workspaces": [
    "./web"
  ],
  "files": [
    "lib/Redis.js",
    "lib/Redis.d.ts"
  ],
  "type": "module",
  "main": "lib/Redis.js",
  "types": "lib/Redis.d.ts",
  "scripts": {
    "build": "bun-tasks bun build:web ::: bun build:root",
    "build:web": "bun --cwd web vite build",
    "build:root": "bun build.js && cd lib && tsc",
    "watch": "esbuild --watch --bundle --platform=node --target=node22 src/index.ts --outfile=dist/build.js",
    "lib": "tsc --project lib/tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests/unit",
    "test:coverage": "bun test tests/unit --coverage"
  },
  "dependencies": {
    "node-fetch": "^3.3.2",
    "redis": "^6.2.1"
  },
  "devDependencies": {
    "@citizenfx/server": "2.0.29753-1",
    "@types/bun": "^1.3.14",
    "@types/node": "^22.19.19",
    "bun-tasks": "^0.1.2",
    "esbuild": "^0.21.5",
    "oxfmt": "^0.53.0",
    "typescript": "^6.0.3"
  }
}